# ==============================================================================
# AgiesAI Sentinel — Production Environment Configuration Template
# Copy this file to .env and configure strong values prior to deployment.
# NEVER commit the active .env file or real credentials to version control.
# ==============================================================================

# Application Environment ('production' enforces strict security gates)
ENVIRONMENT=production

# Cryptographic Session Secret (REQUIRED in production, minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-32-plus-character-cryptographically-random-secret-key-here

# Administrator Credentials (REQUIRED for web console access)
ADMIN_EMAIL=security-admin@yourcompany.com
ADMIN_PASSWORD=your-strong-random-admin-password-here

# CSRF & CORS Trusted Origins (REQUIRED in production)
# Comma-separated list of explicit scheme://host[:port] origins (NO trailing slashes or paths)
CSRF_TRUSTED_ORIGINS=https://sentinel.yourcompany.com

# Database Configuration
# In production, use authenticated connection with TLS/SSL enabled
MONGODB_URI=mongodb://dbuser:dbpassword@127.0.0.1:27017/agiesai_sentinel?authSource=admin&tls=true
MONGODB_DB=agiesai_sentinel

# Reverse Proxy / Ingress Configuration (Optional)
# Comma-separated list of direct upstream proxy IP addresses trusted to supply X-Forwarded-For
# TRUSTED_PROXIES=127.0.0.1,10.0.0.2

# Cookie Security (Optional - automatically defaults to true when ENVIRONMENT=production)
# SESSION_HTTPS_ONLY=true

# Login Rate Limiting (Optional - defaults shown below)
# LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_ACCOUNT_MAX_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
